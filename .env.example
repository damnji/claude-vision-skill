# ===== Vision Skill 配置模板（v3）=====
# 推荐让 AI 助手（如 Claude Code）按 SKILL.md 的「配置向导」逐步完成配置并生成 .env；
# 也可复制本文件为 .env 手动填写。
# .env 含密钥，不要提交到任何 git 仓库。

# 是否启用双模型：true = 主服务 + 备用服务（主服务失败时自动切换）；false = 仅主服务
VISION_DUAL_MODEL=true

# ===== 主服务 =====
VISION_PRIMARY_PROVIDER=OpenAI
VISION_PRIMARY_BASE_URL=https://api.openai.com/v1
VISION_PRIMARY_API_KEY=sk-你的Key
VISION_PRIMARY_MODEL=gpt-4o-mini
# 主模型是否支持上传 BMP 格式图片（默认视为不支持：false；联网核实确认支持后改为 true）
VISION_PRIMARY_BMP=false

# ===== 备用服务（VISION_DUAL_MODEL=true 时填写）=====
VISION_FALLBACK_PROVIDER=Moonshot
VISION_FALLBACK_BASE_URL=https://api.moonshot.cn/v1
VISION_FALLBACK_API_KEY=sk-你的Key
VISION_FALLBACK_MODEL=kimi-k2.6
# 备用模型是否支持上传 BMP 格式图片（默认视为不支持：false；联网核实确认支持后改为 true）
VISION_FALLBACK_BMP=false

# 仅主服务时，把 VISION_DUAL_MODEL 改为 false，并删除/留空备用服务的五行即可
