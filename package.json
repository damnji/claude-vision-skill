{
  "name": "vision-skill",
  "version": "1.0.2",
  "description": "给不支持多模态的 AI 模型（如 DeepSeek）提供识图能力——把图片发给云端视觉模型，返回文字描述。支持任意 OpenAI 兼容接口与 Anthropic 原生接口、主备双模型自动切换、BMP 智能路由、报错自动翻译。",
  "main": "vision.js",
  "bin": {
    "vision": "vision.js"
  },
  "files": [
    "vision.js",
    "SKILL.md",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "test": "node --check vision.js"
  },
  "keywords": [
    "vision",
    "image-recognition",
    "claude",
    "deepseek",
    "multimodal",
    "llm",
    "openai-compatible",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damnji/vision-skill.git"
  },
  "author": "damnji"
}
